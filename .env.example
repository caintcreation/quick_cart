# QuickCart Studio Environment Configuration
# Copy this file to .env on production and update the values

# Application Environment (production / development)
APP_ENV=production
APP_URL=https://your-domain.com

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quickcart
DB_USER=quickcart_user
DB_PASS=YourSecureDatabasePassword123!
